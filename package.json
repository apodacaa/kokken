{
  "name": "elev",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev:eleventy": "npx @11ty/eleventy --serve",
    "dev:tailwind": "npx @tailwindcss/cli -i ./assets/input.css -o ./assets/styles.css --watch",
    "dev": "npm-run-all --parallel dev:*",
    "build:eleventy": "npx @11ty/eleventy",
    "build:tailwind": "npx @tailwindcss/cli -i ./assets/input.css -o ./assets/styles.css --minify",
    "build": "rm -rf _site && npm run build:tailwind && npm run build:eleventy",
    "preview": "npm run build && npx serve _site -l 5000"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
