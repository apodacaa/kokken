{% extends "layouts/base.njk" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

<h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-4">Smoke Guides</h1>

<ul class="list-disc pl-5 space-y-1">
  {% for smoke in collections.smoke %}
    <li>
      <a href="{{ smoke.url }}" class="text-white hover:underline">{{ smoke.data.title }}</a>
    </li>
  {% endfor %}
</ul>

{% endblock %}
