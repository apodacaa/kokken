{% extends "layouts/base.njk" %}

{% block title %}Items tagged with {{ tag }}{% endblock %}

{% block content %}

<h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-4">Tag: {{ tag }}</h1>

{# Recipes #}
<h2 class="text-lg font-semibold text-white mb-2">Recipes</h2>
<ul class="list-disc pl-5 space-y-1 mb-6">
  {% for item in collections[tag] %}
    {% if item.data.layout == "layouts/recipe.njk" %}
      <li>
        <a href="{{ item.url }}" class="text-white hover:underline">{{ item.data.title }}</a>
      </li>
    {% endif %}
  {% endfor %}
</ul>

{# Smoke Guides #}
<h2 class="text-lg font-semibold text-white mb-2">Smoke Guides</h2>
<ul class="list-disc pl-5 space-y-1 mb-6">
  {% for item in collections[tag] %}
    {% if item.data.layout == "layouts/smoke.njk" %}
      <li>
        <a href="{{ item.url }}" class="text-white hover:underline">{{ item.data.title }}</a>
      </li>
    {% endif %}
  {% endfor %}
</ul>

<p><a href="/tags/" class="text-ladybug hover:underline">← Back to all tags</a></p>

{% endblock %}
