{% extends "layouts/base.njk" %}

{% block title %}Items tagged with {{ tag }}{% endblock %}

{% block content %}
  <h1>Tag: {{ tag }}</h1>

  {# Recipes #}
  <h2>Recipes</h2>
  <ul>
    {% for item in collections[tag] %}
      {% if item.data.layout == "layouts/recipe.njk" %}
        <li>
          <a href="{{ item.url }}">{{ item.data.title }}</a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>

  {# Smoke Guides #}
  <h2>Smoke Guides</h2>
  <ul>
    {% for item in collections[tag] %}
      {% if item.data.layout == "layouts/smoke.njk" %}
        <li>
          <a href="{{ item.url }}">{{ item.data.title }}</a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>

  <p><a href="/tags/">← Back to all tags</a></p>
{% endblock %}
