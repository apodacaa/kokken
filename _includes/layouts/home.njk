{% extends "layouts/base.njk" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

<h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-2">Recipes</h1>

<ul class="list-disc pl-5 mb-6 space-y-1">
  {% for recipe in collections.recipes %}
    <li>
      <a href="{{ recipe.url }}" class="text-white hover:underline">{{ recipe.data.title }}</a>
    </li>
  {% endfor %}
</ul>

<h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-2">Cocktails</h1>

<ul class="list-disc pl-5 mb-6 space-y-1">
  {% for cocktail in collections.cocktails %}
    <li>
      <a href="{{ cocktail.url }}" class="text-white hover:underline">{{ cocktail.data.title }}</a>
    </li>
  {% endfor %}
</ul>

<h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-2">Smoke Guides</h1>

<ul class="list-disc pl-5 mb-6 space-y-1">
  {% for post in collections.smokeGuides %}
    <li>
      <a href="{{ post.url }}" class="text-white hover:underline">{{ post.data.title }}</a>
    </li>
  {% endfor %}
</ul>

<h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-2">Grill Guides</h1>

<ul class="list-disc pl-5 mb-6 space-y-1">
  {% for post in collections.grillGuides %}
    <li>
      <a href="{{ post.url }}" class="text-white hover:underline">{{ post.data.title }}</a>
    </li>
  {% endfor %}
  {% if collections.grillGuides | length == 0 %}
    <li class="text-gray-400">No grill guides yet.</li>
  {% endif %}
</ul>

<h2 class="text-ladybug text-xl font-semibold mb-2">Tags</h2>

<ul class="list-none flex flex-wrap gap-2 text-sm text-white">
  {% for tag in collections.tagList %}
    <li>
      <a href="/tags/{{ tag | slug }}/" class="border border-ladybug px-2 py-1 rounded hover:bg-ladybug hover:text-black transition">
        {{ tag }}
      </a>
    </li>
  {% endfor %}
</ul>

{% endblock %}
