{% extends "layouts/base.njk" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

<h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-4">Tags</h1>

<input id="tagFilter" type="text" placeholder="Filter tags..." class="mb-4 w-full md:w-80 border border-ladybug bg-transparent text-white px-2 py-1 rounded text-sm placeholder-gray-400" />

<ul id="tagList" class="list-none flex flex-wrap gap-2 text-sm text-white">
  {% for item in collections.tagsWithCounts %}
    <li data-name="{{ item.tag }}">
      <a href="/tags/{{ item.tag | slug }}/" class="border border-ladybug px-2 py-1 rounded hover:bg-ladybug hover:text-black transition inline-flex items-center gap-1">
        <span>{{ item.tag }}</span>
        <span class="text-gray-400">({{ item.count }})</span>
      </a>
    </li>
  {% endfor %}
  {% if collections.tagsWithCounts | length == 0 %}
    <li class="text-gray-400">No tags yet.</li>
  {% endif %}
  
</ul>

<script>
  (function(){
    const input = document.getElementById('tagFilter');
    const list = document.getElementById('tagList');
    if (!input || !list) return;
    function normalize(s){ return (s||'').toLowerCase().trim(); }
    input.addEventListener('input', function(){
      const q = normalize(this.value);
      for (const li of list.children) {
        const name = normalize(li.getAttribute('data-name'));
        li.style.display = (!q || name.includes(q)) ? '' : 'none';
      }
    });
  })();
</script>

{% endblock %}
