{% extends "layouts/base.njk" %}

{% block title %}Search{% endblock %}

{% block head %}
{% endblock %}

{% block content %}
  <h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-4">Search</h1>

  <div id="search-results" class="space-y-2"></div>
  <script>
    (function () {
      var resultsEl = document.getElementById('search-results');
      if (!resultsEl || !window.fetch) return;

      var params = new URLSearchParams(window.location.search);
      var initialQuery = (params.get('q') || '').trim();
      var indexData = null;
      var loading = false;

      function escapeHtml(s) { return (s||'').replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[c];}); }
      function parseQuery(q) {
        var whole = false; var t = (q||'').trim();
        if ((t.startsWith('"') && t.endsWith('"')) || (t.startsWith("'") && t.endsWith("'"))) {
          whole = true; t = t.slice(1, -1).trim();
        }
        return { term: t, wholeWord: whole };
      }
      function contains(text, term, wholeWord) {
        var hay = (text||'');
        if (!term) return false;
        if (!wholeWord) return hay.toLowerCase().includes(term.toLowerCase());
        try {
          var re = new RegExp('\\b' + term.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + '\\b', 'i');
          return re.test(hay);
        } catch (_) { return hay.toLowerCase().includes(term.toLowerCase()); }
      }
      function highlight(text, term, wholeWord) {
        var safe = escapeHtml(text || '');
        if (!term) return safe;
        try {
          var esc = term.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
          var pattern = wholeWord ? '(\\b' + esc + '\\b)' : '(' + esc + ')';
          var re = new RegExp(pattern, 'ig');
          return safe.replace(re, '<mark class="bg-yellow-500/30">$1</mark>');
        } catch (_) { return safe; }
      }
      function snippetAround(text, term, radius, wholeWord) {
        var t = (text||'');
        var idx = -1;
        if (term) {
          if (wholeWord) {
            try {
              var re = new RegExp('\\b' + term.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + '\\b', 'i');
              var m = re.exec(t);
              idx = m ? m.index : -1;
            } catch (_) { idx = t.toLowerCase().indexOf(term.toLowerCase()); }
          } else {
            idx = t.toLowerCase().indexOf(term.toLowerCase());
          }
        }
        if (idx < 0) return escapeHtml(t.slice(0, Math.min(160, t.length)));
        var start = Math.max(0, idx - (radius||70));
        var end = Math.min(t.length, idx + term.length + (radius||70));
        var pre = start > 0 ? '…' : '';
        var post = end < t.length ? '…' : '';
        return pre + highlight(t.slice(start, end), term, wholeWord) + post;
      }
      function findContexts(doc, term, wholeWord) {
        var contexts = [];
        var ingList = Array.isArray(doc.ingredients_list) ? doc.ingredients_list : [];
        var ingMatch = ingList.find(function (i) { return contains(i, term, wholeWord); });
        if (ingMatch) contexts.push({ label: 'Ingredient', html: highlight(ingMatch, term, wholeWord) });
        var stepList = Array.isArray(doc.steps_list) ? doc.steps_list : [];
        var stepMatch = stepList.find(function (s) { return contains(s, term, wholeWord); });
        if (stepMatch) contexts.push({ label: 'Step', html: highlight(stepMatch, term, wholeWord) });
        var pairList = Array.isArray(doc.pairings_list) ? doc.pairings_list : [];
        var pairMatch = pairList.find(function (p) { return contains(p, term, wholeWord); });
        if (pairMatch) contexts.push({ label: 'Pairing', html: highlight(pairMatch, term, wholeWord) });
        if (contains(doc.excerpt||'', term, wholeWord)) contexts.push({ label: 'Excerpt', html: snippetAround(doc.excerpt, term, 80, wholeWord) });
        return contexts;
      }
      function renderResults(q, docs) {
        if (!q) {
          resultsEl.innerHTML = '<p class="text-gray-400">Type in search box...</p>';
          return;
        }
        if (q.length < 2) {
          resultsEl.innerHTML = '<p class="text-gray-400">More characters needed... </p>';
          return;
        }
        var parsed = parseQuery(q);
        var term = parsed.term;
        var wholeWord = parsed.wholeWord;
        var scored = [];
        for (var i = 0; i < docs.length; i++) {
          var doc = docs[i];
          var inTitle = contains(doc.title || '', term, wholeWord);
          var inExcerpt = contains(doc.excerpt || '', term, wholeWord);
          var inIngredients = contains(doc.ingredients || '', term, wholeWord);
          var inSteps = contains(doc.steps || '', term, wholeWord);
          var inPairings = contains(doc.pairings || '', term, wholeWord);
          if (inTitle || inExcerpt || inIngredients || inSteps || inPairings) {
            var score = 0;
            if (inIngredients) score += 3;
            if (inSteps) score += 2;
            if (inPairings) score += 2;
            if (inTitle) score += 1;
            if (inExcerpt) score += 1;
            scored.push({ doc: doc, score: score });
          }
        }
        scored.sort(function (a, b) { return b.score - a.score; });
        var matches = scored.map(function (x) { return x.doc; });
        if (!matches.length) {
          resultsEl.innerHTML = '<p class="text-gray-400">No results for <span class="text-white">' + q.replace(/</g,'&lt;') + '</span>.</p>';
          return;
        }
        resultsEl.innerHTML = matches.map(function (hit) {
          var title = hit.title || 'Untitled';
          var url = hit.url || '#';
          var ctxs = findContexts(hit, term, wholeWord).slice(0, 2); // show up to two reasons
          var ctxHtml = ctxs.map(function(c){
            return '<p class="text-sm text-gray-300">' + '<span class="text-gray-500 uppercase">' + c.label + ':</span> ' + c.html + '</p>';
          }).join('');
          return (
            '<article class="space-y-1">'
            + '<h2 class="text-white text-base font-semibold"><a href="' + url + '" class="text-ladybug hover:underline">' + highlight(title, term, wholeWord) + '</a></h2>'
            + ctxHtml
            + '</article>'
          );
        }).join('');
      }

      function loadIndex(cb) {
        if (indexData) { cb(); return; }
        if (loading) { return; }
        loading = true;
        fetch('/search/index.json').then(function (r) { return r.json(); }).then(function (docs) {
          indexData = Array.isArray(docs) ? docs : [];
          loading = false;
          cb();
        }).catch(function () {
          loading = false;
          // Fail softly; don't show a warning on the page.
        });
      }

      function loadAndRender(q) {
        if (!q || q.length < 2) { renderResults(q, []); return; }
        loadIndex(function () { renderResults(q, indexData || []); });
      }

      // Bind nav input to update results live on the search page
      var input = document.getElementById('q');
      if (input) {
        input.value = initialQuery;
        var debounce;
        input.addEventListener('input', function (e) {
          var q = (e.target.value || '').trim();
          clearTimeout(debounce);
          debounce = setTimeout(function () { loadAndRender(q); }, 140);
        });
      }

      loadAndRender(initialQuery);
    })();
  </script>
{% endblock %}
