<article class="space-y-8">
  <h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-2">{{ title }}</h1>

  {% if steps %}
    {# Hidden until the cook-mode script runs; see the script at the bottom. #}
    <button type="button" id="cook-open" class="cook-btn" hidden>Cook mode</button>
  {% endif %}

  {% set groups = ingredients | ingredientGroups %}
  {% if groups | length %}
  <div id="ingredients">
    <h2 class="text-lg font-semibold text-white mb-4">Ingredients</h2>
    {% for g in groups %}
      {% if g.section %}
        <p class="text-sm font-semibold text-gray-400 mt-4 mb-2 uppercase tracking-wide">{{ g.section }}</p>
      {% endif %}
      <ul class="list-disc pl-5 space-y-1">
        {% for it in g.items %}<li data-ing="{{ it.i }}">{{ it.text }}</li>{% endfor %}
      </ul>
    {% endfor %}
  </div>
  {% endif %}

  {% include "partials/recipe-steps.njk" %}

  {% if notes %}
    <div>
      <h2 class="text-lg font-semibold text-white mb-2">Notes</h2>
      <p class="text-gray-300">{{ notes }}</p>
    </div>
  {% endif %}

  {# Pairings (support both 'pairings' and common typo 'parings') #}
  {% if pairings or parings %}
    {% set p = pairings or parings %}
    <div>
      <h2 class="text-lg font-semibold text-white mb-2">Pairings</h2>
      <ul class="list-disc pl-5 space-y-1">
        {% if p.wine %}
          <li>
            <span class="font-semibold">Wine:</span>
            {% if p.wine is string %}
              {{ p.wine }}
            {% else %}
              {{ p.wine | join('; ') }}
            {% endif %}
          </li>
        {% endif %}
        {% if p.beer %}
          <li>
            <span class="font-semibold">Beer:</span>
            {% if p.beer is string %}
              {{ p.beer }}
            {% else %}
              {{ p.beer | join('; ') }}
            {% endif %}
          </li>
        {% endif %}
      </ul>
    </div>
  {% endif %}

  {% if references %}
    <div>
      <h2 class="text-lg font-semibold text-white mb-2">Related Recipes</h2>
      <ul class="list-disc pl-5 space-y-1">
        {% set referenceBase = {
          recipe: "/recipes/",
          smoke: "/smoke/",
          cocktail: "/cocktails/",
          grill: "/grill/"
        } %}
        {% for ref in references %}
          {% set path = referenceBase[ref.type] or "/" %}
          <li>
            <a href="{{ path }}{{ ref.slug }}/" class="text-ladybug hover:underline">{{ ref.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if site.features.tags and tags %}
    <div class="text-sm text-gray-400 flex flex-wrap gap-2">
      {% for tag in tags %}
        <a href="/tags/{{ tag | slug }}/" class="border border-ladybug px-2 py-1 rounded hover:bg-ladybug hover:text-black transition">
          {{ tag }}
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {# Prev / Next navigation for Recipes and Cocktails #}
  {% set coll = null %}
  {% if layout == 'layouts/recipe.njk' %}
    {% set coll = collections.recipes %}
  {% elseif layout == 'layouts/cocktail.njk' %}
    {% set coll = collections.cocktails %}
  {% endif %}

  {% if coll %}
    {% set currentUrl = page.url %}
    {% set idx = -1 %}
    {% for item in coll %}
      {% if item.url == currentUrl %}
        {% set idx = loop.index0 %}
      {% endif %}
    {% endfor %}

    {% if idx > -1 %}
      {% if idx > 0 %}{% set prev = coll[idx - 1] %}{% endif %}
      {% if idx + 1 < (coll | length) %}{% set next = coll[idx + 1] %}{% endif %}

      <nav aria-label="Pagination" class="mt-6 pt-4 border-t border-gray-700">
        <div class="flex items-center justify-between text-sm">
          <div>
            {% if prev %}
              <a href="{{ prev.url }}" class="text-gray-400 hover:text-ladybug hover:underline">← {{ prev.data.title }}</a>
            {% endif %}
          </div>
          <div class="text-right">
            {% if next %}
              <a href="{{ next.url }}" class="text-gray-400 hover:text-ladybug hover:underline">{{ next.data.title }} →</a>
            {% endif %}
          </div>
        </div>
      </nav>
    {% endif %}
  {% endif %}
</article>

{# Cook mode: one step at a time, full screen, with the ingredients that step
   uses beside it (matched at build time by _includes/cook-steps.js). Card 0
   gathers everything. The screen stays on while it is open (Screen Wake
   Lock API, where supported). Styles: .cook in assets/input.css. #}
{% if steps %}
  {% set cs = steps | cookSteps(ingredients) %}
  <div id="cook" class="cook" hidden role="dialog" aria-modal="true" aria-label="Cook mode: {{ title }}">
    <div class="cook-bar">
      <span id="cook-count" aria-live="polite"></span>
      <button type="button" id="cook-exit" class="cook-btn">Exit</button>
    </div>
    <div class="cook-body">
      <section class="cook-card">
        <h2 class="cook-title">{{ title }}</h2>
        {% for g in groups %}
          {% if g.section %}<p class="cook-section">{{ g.section }}</p>{% endif %}
          <ul class="cook-ings">
            {% for it in g.items %}<li data-ing="{{ it.i }}">{{ it.text }}</li>{% endfor %}
          </ul>
        {% endfor %}
      </section>
      {% for s in cs %}
        <section class="cook-card" hidden>
          <p class="cook-step">{{ s.text }}</p>
          {% if s.items | length %}
            <ul class="cook-ings">
              {% for it in s.items %}<li data-ing="{{ it.i }}">{{ it.text }}{% if it.section %} <span class="cook-from">{{ it.section }}</span>{% endif %}</li>{% endfor %}
            </ul>
          {% endif %}
        </section>
      {% endfor %}
    </div>
    <div class="cook-nav">
      <button type="button" id="cook-prev" class="cook-btn">Back</button>
      <button type="button" id="cook-next" class="cook-btn cook-btn-primary">Next</button>
    </div>
  </div>
{% endif %}

{# Tap an ingredient to cross it off while prepping, in the list or in cook
   mode; both copies of an item ([data-ing] index) toggle together.
   Progressive enhancement: without JavaScript the list is plain. Checks last
   for the browser session (sessionStorage, keyed by page) so a reload
   mid-prep keeps them; they are never saved beyond that.
   Styles: .ingredient-done in assets/input.css. #}
<script>
  (function () {
    var items = document.querySelectorAll('[data-ing]');
    if (!items.length) return;
    var key = 'kokken-checked:' + location.pathname;
    var done = [];
    try { done = (JSON.parse(sessionStorage.getItem(key)) || []).map(String); } catch (_) {}
    function set(i, on) {
      document.querySelectorAll('[data-ing="' + i + '"]').forEach(function (li) {
        li.classList.toggle('ingredient-done', on);
        li.setAttribute('aria-checked', on ? 'true' : 'false');
      });
    }
    function toggle(li) {
      var i = li.getAttribute('data-ing');
      var at = done.indexOf(i);
      if (at > -1) done.splice(at, 1); else done.push(i);
      set(i, at < 0);
      try { sessionStorage.setItem(key, JSON.stringify(done)); } catch (_) {}
    }
    items.forEach(function (li) {
      li.setAttribute('role', 'checkbox');
      li.setAttribute('tabindex', '0');
      li.setAttribute('aria-checked', 'false');
      li.addEventListener('click', function () { toggle(li); });
      li.addEventListener('keydown', function (e) {
        if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggle(li); }
      });
    });
    done.forEach(function (i) { set(i, true); });
  })();
</script>

{# Cook mode controls. The step shown is remembered for the browser session.
   The browser drops a wake lock whenever the tab is hidden, so it is
   requested again when the tab comes back while cook mode is open. #}
<script>
  (function () {
    var cook = document.getElementById('cook');
    var open = document.getElementById('cook-open');
    if (!cook || !open) return;
    var cards = cook.querySelectorAll('.cook-card');
    var count = document.getElementById('cook-count');
    var prev = document.getElementById('cook-prev');
    var next = document.getElementById('cook-next');
    var key = 'kokken-cook:' + location.pathname;
    var at = 0;
    var lock = null;
    try { at = Math.min(parseInt(sessionStorage.getItem(key), 10) || 0, cards.length - 1); } catch (_) {}

    function wake() {
      if (!('wakeLock' in navigator) || cook.hidden || lock || document.visibilityState !== 'visible') return;
      navigator.wakeLock.request('screen').then(function (l) {
        lock = l;
        l.addEventListener('release', function () { lock = null; });
      }).catch(function () {});
    }
    function sleep() {
      if (lock) { lock.release().catch(function () {}); lock = null; }
    }
    function show(n) {
      at = Math.max(0, Math.min(n, cards.length - 1));
      cards.forEach(function (c, i) { c.hidden = i !== at; });
      count.textContent = at === 0 ? 'Gather' : 'Step ' + at + ' / ' + (cards.length - 1);
      prev.disabled = at === 0;
      next.textContent = at === 0 ? 'Start' : at === cards.length - 1 ? 'Done' : 'Next';
      cook.querySelector('.cook-body').scrollTop = 0;
      try { sessionStorage.setItem(key, String(at)); } catch (_) {}
    }
    function enter() {
      cook.hidden = false;
      document.documentElement.classList.add('cook-on');
      show(at);
      wake();
      next.focus();
    }
    function exit() {
      cook.hidden = true;
      document.documentElement.classList.remove('cook-on');
      sleep();
      open.focus();
    }

    open.hidden = false;
    open.addEventListener('click', enter);
    document.getElementById('cook-exit').addEventListener('click', exit);
    prev.addEventListener('click', function () { show(at - 1); });
    next.addEventListener('click', function () {
      if (at === cards.length - 1) { show(0); exit(); } else show(at + 1);
    });
    document.addEventListener('keydown', function (e) {
      if (cook.hidden) return;
      if (e.key === 'Escape') exit();
      else if (e.key === 'ArrowRight') show(at + 1);
      else if (e.key === 'ArrowLeft') show(at - 1);
    });
    document.addEventListener('visibilitychange', wake);
  })();
</script>
