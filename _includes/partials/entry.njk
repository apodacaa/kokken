<article class="space-y-8">
  <h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-2">{{ title }}</h1>

  {% if ingredients %}
  <div>
    <h2 class="text-lg font-semibold text-white mb-4">Ingredients</h2>
    <ul class="list-disc pl-5 space-y-1">
      {% for entry in ingredients %}
        {% if entry is string %}
          <li>{{ entry }}</li>
        {% elif entry.items %}
          </ul>
          {% if entry.section and entry.section != "_main_" %}
            <p class="text-sm font-semibold text-gray-400 mt-4 mb-2 uppercase tracking-wide">{{ entry.section }}</p>
          {% endif %}
          <ul class="list-disc pl-5 space-y-1">
            {% for item in entry.items %}
              <li>{{ item }}</li>
            {% endfor %}
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endif %}

  {% include "partials/recipe-steps.njk" %}

  {% if notes %}
    <div>
      <h2 class="text-lg font-semibold text-white mb-2">Notes</h2>
      <p class="text-gray-300">{{ notes }}</p>
    </div>
  {% endif %}

  {% if references %}
    <div>
      <h2 class="text-lg font-semibold text-white mb-2">Related Recipes</h2>
      <ul class="list-disc pl-5 space-y-1">
        {% set referenceBase = {
          recipe: "/recipes/",
          smoke: "/smoke/",
          cocktail: "/cocktails/"
        } %}
        {% for ref in references %}
          {% set path = referenceBase[ref.type] or "/" %}
          <li>
            <a href="{{ path }}{{ ref.slug }}/" class="text-ladybug hover:underline">{{ ref.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if tags %}
    <div class="text-sm text-gray-400 flex flex-wrap gap-2">
      {% for tag in tags %}
        <a href="/tags/{{ tag | slug }}/" class="border border-ladybug px-2 py-1 rounded hover:bg-ladybug hover:text-black transition">
          {{ tag }}
        </a>
      {% endfor %}
    </div>
  {% endif %}
</article>
