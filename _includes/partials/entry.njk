<article class="space-y-8">
  <h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight mb-2">{{ title }}</h1>

  {% if ingredients %}
  <div>
    <h2 class="text-lg font-semibold text-white mb-4">Ingredients</h2>
    <ul class="list-disc pl-5 space-y-1">
      {% for entry in ingredients %}
        {% if entry is string %}
          <li>{{ entry }}</li>
        {% elif entry.items %}
          </ul>
          {% if entry.section and entry.section != "_main_" %}
            <p class="text-sm font-semibold text-gray-400 mt-4 mb-2 uppercase tracking-wide">{{ entry.section }}</p>
          {% endif %}
          <ul class="list-disc pl-5 space-y-1">
            {% for item in entry.items %}
              <li>{{ item }}</li>
            {% endfor %}
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endif %}

  {% include "partials/recipe-steps.njk" %}

  {% if notes %}
    <div>
      <h2 class="text-lg font-semibold text-white mb-2">Notes</h2>
      <p class="text-gray-300">{{ notes }}</p>
    </div>
  {% endif %}

  {# Pairings (support both 'pairings' and common typo 'parings') #}
  {% if pairings or parings %}
    {% set p = pairings or parings %}
    <div>
      <h2 class="text-lg font-semibold text-white mb-2">Pairings</h2>
      <ul class="list-disc pl-5 space-y-1">
        {% if p.wine %}
          <li>
            <span class="font-semibold">Wine:</span>
            {% if p.wine is string %}
              {{ p.wine }}
            {% else %}
              {{ p.wine | join('; ') }}
            {% endif %}
          </li>
        {% endif %}
        {% if p.beer %}
          <li>
            <span class="font-semibold">Beer:</span>
            {% if p.beer is string %}
              {{ p.beer }}
            {% else %}
              {{ p.beer | join('; ') }}
            {% endif %}
          </li>
        {% endif %}
      </ul>
    </div>
  {% endif %}

  {% if references %}
    <div>
      <h2 class="text-lg font-semibold text-white mb-2">Related Recipes</h2>
      <ul class="list-disc pl-5 space-y-1">
        {% set referenceBase = {
          recipe: "/recipes/",
          smoke: "/smoke/",
          cocktail: "/cocktails/",
          grill: "/grill/"
        } %}
        {% for ref in references %}
          {% set path = referenceBase[ref.type] or "/" %}
          <li>
            <a href="{{ path }}{{ ref.slug }}/" class="text-ladybug hover:underline">{{ ref.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if site.features.tags and tags %}
    <div class="text-sm text-gray-400 flex flex-wrap gap-2">
      {% for tag in tags %}
        <a href="/tags/{{ tag | slug }}/" class="border border-ladybug px-2 py-1 rounded hover:bg-ladybug hover:text-black transition">
          {{ tag }}
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {# Prev / Next navigation for Recipes and Cocktails #}
  {% set coll = null %}
  {% if layout == 'layouts/recipe.njk' %}
    {% set coll = collections.recipes %}
  {% elseif layout == 'layouts/cocktail.njk' %}
    {% set coll = collections.cocktails %}
  {% endif %}

  {% if coll %}
    {% set currentUrl = page.url %}
    {% set idx = -1 %}
    {% for item in coll %}
      {% if item.url == currentUrl %}
        {% set idx = loop.index0 %}
      {% endif %}
    {% endfor %}

    {% if idx > -1 %}
      {% if idx > 0 %}{% set prev = coll[idx - 1] %}{% endif %}
      {% if idx + 1 < (coll | length) %}{% set next = coll[idx + 1] %}{% endif %}

      <nav aria-label="Pagination" class="mt-6 pt-4 border-t border-gray-700">
        <div class="flex items-center justify-between text-sm">
          <div>
            {% if prev %}
              <a href="{{ prev.url }}" class="text-gray-400 hover:text-ladybug hover:underline">← {{ prev.data.title }}</a>
            {% endif %}
          </div>
          <div class="text-right">
            {% if next %}
              <a href="{{ next.url }}" class="text-gray-400 hover:text-ladybug hover:underline">{{ next.data.title }} →</a>
            {% endif %}
          </div>
        </div>
      </nav>
    {% endif %}
  {% endif %}
</article>
