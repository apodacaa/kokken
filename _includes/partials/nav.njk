<div class="flex items-center justify-between gap-4 mb-4">
  <h1 class="text-ladybug text-2xl font-bold uppercase tracking-tight">
    <a href="/" class="hover:underline">Køkken</a>
  </h1>
  <form action="/search/" method="get" class="flex-shrink-0" id="site-search-form">
    <label for="q" class="sr-only">Search</label>
    <div class="flex gap-2 items-center">
      <div class="relative">
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Search... "
          class="w-56 md:w-80 bg-black/30 text-white placeholder-gray-400 border border-gray-700 focus:border-ladybug focus:outline-none rounded px-3 py-2 transition"
          autocomplete="off"
        />
        <div id="search-suggestions" class="hidden absolute left-0 right-0 mt-2 bg-black/90 border border-gray-700 rounded shadow-lg overflow-hidden"></div>
      </div>
      <button type="submit" class="px-3 py-2 rounded bg-ladybug text-black font-semibold hover:opacity-90 transition">Search</button>
    </div>
  </form>
</div>

<nav class="mb-8">
  <ul class="flex w-full justify-between flex-wrap gap-4 text-sm text-white">
    <li><a href="/" class="hover:text-ladybug transition">Home</a></li>
    <li><a href="/recipes/" class="hover:text-ladybug transition">Recipes</a></li>
    <li><a href="/cocktails/" class="hover:text-ladybug transition">Cocktails</a></li>
    <li><a href="/grill/" class="hover:text-ladybug transition">Grill Guides</a></li>
    <li><a href="/smoke/" class="hover:text-ladybug transition">Smoke Guides</a></li>
    <li><a href="/tags/" class="hover:text-ladybug transition">Tags</a></li>
  </ul>
</nav>
