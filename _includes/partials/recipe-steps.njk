{% if instructions %}
  <div>
    <h2 class="text-lg font-semibold text-white mb-2">Instructions</h2>
    <p class="text-gray-300 whitespace-pre-line">{{ instructions }}</p>
  </div>
{% endif %}

{% if steps %}
  <div>
    <h2 class="text-lg font-semibold text-white mb-2">Steps</h2>
    <ol class="list-decimal pl-5 space-y-2">
      {% for step in steps %}
        <li>{{ step }}</li>
      {% endfor %}
    </ol>
  </div>
{% endif %}
